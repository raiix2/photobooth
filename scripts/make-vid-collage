#!/bin/bash

if [[ $1 =~ -h|--help ]]; then
  cat <<HELP
This script overlays all given videos into a collage as specified in the options

Usage:

    make-vid-collage <...video files> <output file>

HELP
  exit 0
fi


ffmpeg \
  -i $1 -i $2 -i $3 -i /var/www/html/resources/img/background/10287791_vertical.png \
  -filter_complex "
    [3:v] scale=750x2250 [base];
    [0:v] setpts=PTS-STARTPTS, scale=694x462 [vid1];
    [1:v] setpts=PTS-STARTPTS, scale=694x462 [vid2];
    [2:v] setpts=PTS-STARTPTS, scale=694x462 [vid3];
    [base][vid1] overlay=shortest=0:x=28:y=112 [tmp1];
    [tmp1][vid2] overlay=shortest=0:x=28:y=602 [tmp2];
    [tmp2][vid3] overlay=shortest=0:x=28:y=1092
  " \
  -c:v libx264 -an -pix_fmt yuv420p $4